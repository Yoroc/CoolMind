# CoolMind Configuration Template

# Copy this to config.yaml and adjust as needed

model:
  # Default model to use (can be overridden at runtime)
  default_name: "gpt2"
  
  # Model loading options
  torch_dtype: "float16"  # Options: float16, bfloat16, float32
  device_map: "auto"      # Options: auto, balanced_low_0, sequential, etc.

thermal:
  # Temperature thresholds (in Celsius)
  max_gpu_temp: 80.0
  offload_threshold: 75.0
  cooldown_threshold: 65.0
  
  # Monitoring interval (seconds)
  check_interval: 2.0
  
  # Windows-specific WMI settings
  use_wmi: true

inference:
  # Default generation parameters
  max_length: 50
  temperature: 0.7
  top_p: 0.9
  do_sample: true

logging:
  level: "INFO"  # Options: DEBUG, INFO, WARNING, ERROR, CRITICAL
  format: "%(asctime)s - %(name)s - %(levelname)s - %(message)s"